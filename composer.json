{
    "name": "xyj2156/k3cloud-client",
    "description": "面向金蝶云星空（K/3 Cloud）WebAPI 的非官方、独立编写 PHP 客户端；同时支持第三方应用签名鉴权（X-Kd / X-Api HMAC）与经典用户名/密码会话登录。",
    "type": "library",
    "keywords": [
        "kingdee",
        "k3cloud",
        "k3 cloud",
        "webapi",
        "erp",
        "sdk",
        "client",
        "金蝶",
        "金蝶云星空",
        "云星空",
        "星空",
        "二次开发"
    ],
    "license": "MIT",
    "readme": "README.md",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "K3Cloud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "K3Cloud\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
